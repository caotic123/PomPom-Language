import boostrap/pattern_unification.

Static bootstrap-universe-check-work : *.
Static bootstrap-universe-check-work-new : ~ BootstrapTerm ~> ~ BootstrapEnvironment ~> ~ Bool ~> bootstrap-universe-check-work.

BootstrapUniverseCheckWork
  {bootstrap-universe-check-work :: |bootstrap-universe-check-work-new}.

bootstrap-universe-check-recur
  |work :: ~ BootstrapUniverseCheckWork ~> Bool => [work of Bool
    |(bootstrap-universe-check-work-new term environment allow-kind) => [(bootstrap-normalize-erased-recur (bootstrap-normalize-erased-work-new term environment)) of Bool
      |bootstrap-no-term => false
      |(bootstrap-some-term normalized) => [(bootstrap-is-name normalized bootstrap-set-name) of Bool
        |true => true
        |false => [(bootstrap-is-name normalized bootstrap-type-name) of Bool
          |true => true
          |false => [allow-kind of Bool
            |true => (bootstrap-is-name normalized bootstrap-kind-name)
            |false => false
          ]
        ]
      ]
    ]
  ].

Static bootstrap-complete-typing-work : *.
Static bootstrap-complete-typing-work-new : ~ BootstrapTerm ~> ~ BootstrapTypingMode ~> ~ BootstrapTerm ~> ~ BootstrapEnvironment ~> bootstrap-complete-typing-work.

BootstrapCompleteTypingWork
  {bootstrap-complete-typing-work :: |bootstrap-complete-typing-work-new}.

bootstrap-complete-typing-recur
  |work :: ~ BootstrapCompleteTypingWork ~> BootstrapTypingOutput => [work of BootstrapTypingOutput
    |(bootstrap-complete-typing-work-new subject mode inferred environment) => [mode of BootstrapTypingOutput
      |(bootstrap-pattern-check-mode expected) => (bootstrap-pattern-finish-recur (bootstrap-pattern-finish-work-new subject inferred expected environment))
      |bootstrap-pattern-infer-mode => (bootstrap-typed-output inferred environment)
      |bootstrap-infer-mode => (bootstrap-typed-output inferred environment)
      |(bootstrap-check-mode expected) => (bootstrap-finish-check-recur (bootstrap-finish-check-work-new subject inferred expected environment))
    ]
  ].

Static bootstrap-environment-unification-work : *.
Static bootstrap-environment-unification-work-new : (target : BootstrapTerm) ~ BootstrapTerm ~> ~ BootstrapEnvironment ~> ~ (BootstrapTermAccessibility target) ~> bootstrap-environment-unification-work.

BootstrapEnvironmentUnificationWork
  {bootstrap-environment-unification-work :: |bootstrap-environment-unification-work-new}.

bootstrap-environment-unification-recur
  |work :: ~ BootstrapEnvironmentUnificationWork ~> BootstrapTypingOutput => [work of BootstrapTypingOutput
    |(bootstrap-environment-unification-work-new target origin environment target-access) => [environment of BootstrapTypingOutput
      |(bootstrap-environment-new local unifier globals bindings certificates) => [(bootstrap-unify-recur (bootstrap-unification-work-new target origin (bootstrap-state-new local unifier) target-access)) of BootstrapTypingOutput
        |bootstrap-no-state => bootstrap-typing-failed
        |(bootstrap-some-state state) => [state of BootstrapTypingOutput
          |(bootstrap-state-new new-local new-unifier) => (bootstrap-environment-output (bootstrap-environment-new new-local new-unifier globals bindings certificates))
        ]
      ]
    ]
  ].

Static bootstrap-typing-work : *.
Static bootstrap-typing-term-work : (term : BootstrapTerm) ~ BootstrapTypingMode ~> ~ BootstrapEnvironment ~> ~ (BootstrapTermAccessibility term) ~> bootstrap-typing-work.
Static bootstrap-typing-constructor-list-work : ~ BootstrapTerm ~> (constructors : (List BootstrapTerm)) ~> ~ BootstrapEnvironment ~> ~ (BootstrapTermListAccessibility constructors) ~> bootstrap-typing-work.
Static bootstrap-typing-clause-list-work : ~ BootstrapTerm ~> ~ BootstrapTerm ~> ~ BootstrapTerm ~> (clauses : (List BootstrapClause)) ~> ~ BootstrapEnvironment ~> ~ (BootstrapClauseListAccessibility clauses) ~> bootstrap-typing-work.

BootstrapTypingWork
  {bootstrap-typing-work :: |bootstrap-typing-term-work |bootstrap-typing-constructor-list-work |bootstrap-typing-clause-list-work}.

Static bootstrap-pi-typing-work : *.
Static bootstrap-pi-typing-work-new : (binder : BootstrapVar) (domain : BootstrapTerm) (body : BootstrapTerm) ~ BootstrapTypingMode ~> ~ BootstrapEnvironment ~> ~ (BootstrapTermAccessibility domain) ~> ~ (BootstrapTermAccessibility body) ~> bootstrap-pi-typing-work.

BootstrapPiTypingWork
  {bootstrap-pi-typing-work :: |bootstrap-pi-typing-work-new}.

bootstrap-pi-typing-recur
  |work :: ~ BootstrapPiTypingWork ~> BootstrapTypingOutput => [work of BootstrapTypingOutput
    |(bootstrap-pi-typing-work-new binder domain body mode environment domain-access body-access) => [(bootstrap-typing-recur (bootstrap-typing-term-work domain bootstrap-infer-mode environment domain-access)) of BootstrapTypingOutput
      |bootstrap-typing-failed => bootstrap-typing-failed
      |(bootstrap-environment-output _) => bootstrap-typing-failed
      |(bootstrap-typed-output domain-type domain-environment) => [(bootstrap-universe-check-recur (bootstrap-universe-check-work-new domain-type domain-environment false)) of BootstrapTypingOutput
        |false => bootstrap-typing-failed
        |true => [domain-environment of BootstrapTypingOutput
          |(bootstrap-environment-new local unifier globals bindings certificates) => [(bootstrap-typing-recur (bootstrap-typing-term-work body bootstrap-infer-mode (bootstrap-environment-new (new BootstrapTyping (bootstrap-typing-new (bootstrap-variable-term binder) domain) local) unifier globals bindings certificates) body-access)) of BootstrapTypingOutput
            |bootstrap-typing-failed => bootstrap-typing-failed
            |(bootstrap-environment-output _) => bootstrap-typing-failed
            |(bootstrap-typed-output body-type body-environment) => [(bootstrap-universe-check-recur (bootstrap-universe-check-work-new body-type body-environment true)) of BootstrapTypingOutput
              |false => bootstrap-typing-failed
              |true => [(bootstrap-normalize-erased-recur (bootstrap-normalize-erased-work-new body-type body-environment)) of BootstrapTypingOutput
                |bootstrap-no-term => bootstrap-typing-failed
                |(bootstrap-some-term normalized-body-type) => [(bootstrap-is-name normalized-body-type bootstrap-kind-name) of BootstrapTypingOutput
                  |true => (bootstrap-complete-typing-recur (bootstrap-complete-typing-work-new (bootstrap-pi-term binder domain body) mode bootstrap-kind-term body-environment))
                  |false => (bootstrap-complete-typing-recur (bootstrap-complete-typing-work-new (bootstrap-pi-term binder domain body) mode bootstrap-type-term body-environment))
                ]
              ]
            ]
          ]
        ]
      ]
    ]
  ].

