            |(bootstrap-some-term normalized-function-type) => [normalized-function-type of BootstrapTypingOutput
              |(bootstrap-pi-term binder domain codomain) => [(bootstrap-typing-recur (bootstrap-typing-term-work argument (bootstrap-check-mode domain) function-environment argument-access)) of BootstrapTypingOutput
