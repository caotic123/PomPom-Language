                |(bootstrap-typed-output _ argument-environment) => [(bootstrap-substitution-recur (bootstrap-substitution-term-work (bootstrap-variable-term binder) argument codomain (bootstrap-term-accessibility-instance codomain))) of BootstrapTypingOutput
