bootstrap-infer
  |term environment :: ~ BootstrapTerm ~> ~ BootstrapEnvironment ~> BootstrapTypingOutput =>
    (bootstrap-typing-recur (bootstrap-typing-term-work term bootstrap-infer-mode environment (bootstrap-term-accessibility-instance term))).

bootstrap-check
