bootstrap-name-char-equal
  |left right :: ~ Char ~> ~ Char ~> Bool =>
    (eql (bootstrap-name-char-code left) (bootstrap-name-char-code right)).

BootstrapStringSmaller
  |larger smaller :: (larger : String) (smaller : String) ~> * => [larger of *
    |string-empty => False
    |(string-cons _ tail) => (Eq String smaller tail)
  ].

bootstrap-string-accessibility
  |value :: (value : String) ~> (BootstrapAccessibility String BootstrapStringSmaller value) => [value of (BootstrapAccessibility String BootstrapStringSmaller value)
    |string-empty => (bootstrap-accessibility-intro String BootstrapStringSmaller string-empty (|smaller witness :: (smaller : String) ~> ~ (BootstrapStringSmaller string-empty smaller) ~> (BootstrapAccessibility String BootstrapStringSmaller smaller) => [witness of (BootstrapAccessibility String BootstrapStringSmaller smaller)]))
    |(string-cons head tail) => (bootstrap-accessibility-intro String BootstrapStringSmaller (string-cons head tail) (|smaller witness :: (smaller : String) ~> ~ (BootstrapStringSmaller (string-cons head tail) smaller) ~> (BootstrapAccessibility String BootstrapStringSmaller smaller) => [witness of (BootstrapAccessibility String BootstrapStringSmaller smaller)
      |(refl _ _) => (bootstrap-string-accessibility tail)
    ]))
  ].

Static bootstrap-name-equality-work : *.
Static bootstrap-name-equality-work-new : (left : String) ~ String ~> ~ (BootstrapAccessibility String BootstrapStringSmaller left) ~> bootstrap-name-equality-work.

BootstrapNameEqualityWork
  {bootstrap-name-equality-work :: |bootstrap-name-equality-work-new}.

bootstrap-name-equal-recur
  |work :: ~ BootstrapNameEqualityWork ~> Bool => [work of Bool
    |(bootstrap-name-equality-work-new left right accessibility) => [accessibility of Bool
      |(bootstrap-accessibility-intro _ _ _ descend) => [left of Bool
        |string-empty => [right of Bool
          |string-empty => true
          |(string-cons _ _) => false
        ]
        |(string-cons left-head left-tail) => [right of Bool
          |string-empty => false
          |(string-cons right-head right-tail) =>
            [(bootstrap-name-char-equal left-head right-head) of Bool
              |true => (bootstrap-name-equal-recur (bootstrap-name-equality-work-new left-tail right-tail (descend left-tail (refl String left-tail))))
              |false => false
            ]
        ]
      ]
    ]
  ].

bootstrap-name-equal
  |left right :: ~ String ~> ~ String ~> Bool =>
    (bootstrap-name-equal-recur (bootstrap-name-equality-work-new left right (bootstrap-string-accessibility left))).

bootstrap-name-empty-proof
  ((refl Bool true) :: (Eq Bool (bootstrap-name-equal "" "") true)).

bootstrap-name-equal-proof
  ((refl Bool true) :: (Eq Bool (bootstrap-name-equal "0af09" "0af09") true)).

bootstrap-name-different-proof
  ((refl Bool false) :: (Eq Bool (bootstrap-name-equal "0af09" "0af08") false)).
