Static string : *.
Static string-empty : string.
Static string-cons : ~ Char ~> ~ {string :: |string-empty |string-cons} ~> string.

String
  {string :: |string-empty |string-cons}.

string-length
  |value :: ~ String ~> Nat => [value of Nat
    |string-empty => 0
    |(string-cons _ tail) => (+1 (string-length tail))
  ].

string-concat
  |left right :: ~ String ~> ~ String ~> String => [left of String
    |string-empty => right
    |(string-cons head tail) => (string-cons head (string-concat tail right))
  ].
